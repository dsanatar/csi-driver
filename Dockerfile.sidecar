ARG builder_image=docker.io/library/golang:1.24.13
FROM ${builder_image} AS builder
WORKDIR /src/kubevirt-csi-driver
COPY . .
RUN go build -mod=vendor -trimpath -o nfs-sidecar ./cmd/nfs-sidecar/

FROM quay.io/centos/centos:stream9
# util-linux provides lsblk, blkid, mount
# xfsprogs provides mkfs.xfs
RUN dnf install -y util-linux xfsprogs && dnf clean all

COPY --from=builder /src/kubevirt-csi-driver/nfs-sidecar /nfs-sidecar
ENTRYPOINT ["/nfs-sidecar"]
